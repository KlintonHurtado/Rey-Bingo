# Bingo Runner - Configuracion WebSocket Edition

# URL de tu aplicacion PHP (sin slash final)
# Para comunicacion interna en el mismo servidor o red Docker:
# APP_URL=http://127.0.0.1
# APP_HOST_HEADER=bingo.reybingo.com
APP_URL=https://bingo.reybingo.com
# APP_HOST_HEADER=bingo.reybingo.com

# Token secreto que valida el runner vs PHP (debe coincidir con CRON_TOKEN en .env de CI4)
CRON_TOKEN=reybingo_cron_secret_key_2026

# Cada cuantos ms sincroniza que juegos automaticos estan activos (recomendado: 8000)
SYNC_INTERVAL_MS=8000

# Intervalo MINIMO entre balotas en ms (el servidor envia el intervalo real; esto es el floor)
MIN_TICK_MS=3000

# Puerto del health-check interno (solo localhost, no exponer al exterior)
STATUS_PORT=9999
